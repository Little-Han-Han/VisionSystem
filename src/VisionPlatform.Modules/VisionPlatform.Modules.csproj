<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{3F2A1B4C-6001-4A7E-9D21-6E8B5C4A6001}</ProjectGuid>
    <OutputType>Library</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>VisionPlatform.Modules</RootNamespace>
    <AssemblyName>VisionPlatform.Modules</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <!-- 模块包与宿主同目录输出（不再单独建 Modules 子目录）：
         宿主按需反射加载，不参与编译期引用。部署 = 一个目录，省掉"漏拷 Modules"这类现场问题。
         FlowModuleRegistry 先找 Modules 子目录、找不到回退程序目录（老部署仍兼容）。 -->
    <OutputPath>..\..\bin\x64\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="BuiltInDefaults.cs" />
    <Compile Include="BuiltInModules.cs" />
    <Compile Include="BuiltInParamTables.cs" />
    <Compile Include="BuiltInPorts.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="..\SharedVersion.cs">
      <Link>Properties\SharedVersion.cs</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\VisionPlatform.Framework\VisionPlatform.Framework.csproj">
      <Project>{3F2A1B4C-4001-4A7E-9D21-6E8B5C4A4001}</Project>
      <Name>VisionPlatform.Framework</Name>
      <!-- 不要把自己的依赖复制进 Modules：否则 LoadFrom 会再加载一份 Framework，
           导致 IFlowModulePackage 的类型标识不一致（模块被静默忽略）。 -->
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
