<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <VCProjectVersion>17.0</VCProjectVersion>
    <ProjectGuid>{3F2A1B4C-2001-4A7E-9D21-6E8B5C4A2001}</ProjectGuid>
    <RootNamespace>VisionAlgoNative</RootNamespace>
    <Keyword>Win32Proj</Keyword>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Condition="'$(Configuration)'=='Debug'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <UseDebugLibraries>true</UseDebugLibraries>
    <PlatformToolset>v143</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>v143</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
    <WholeProgramOptimization>true</WholeProgramOptimization>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="ExtensionSettings" />
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props"
            Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')"
            Label="LocalAppDataPlatform" />
  </ImportGroup>

  <PropertyGroup Label="UserMacros">
    <!-- OpenCV 预编译包根目录：只提供 vc14/vc15 的 lib，但 MSVC 2015~2022 ABI 兼容，
         v143 工具集可直接链接 vc15 的库。 -->
    <OpenCVRoot>$(ProjectDir)..\..\ThirdParty\OpenCV</OpenCVRoot>
  </PropertyGroup>

  <PropertyGroup>
    <TargetName>VisionAlgo.Native</TargetName>
    <OutDir>$(ProjectDir)..\..\bin\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>obj\$(Platform)\$(Configuration)\</IntDir>
  </PropertyGroup>

  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <Optimization>Disabled</Optimization>
      <PreprocessorDefinitions>WIN32;_WIN64;_DEBUG;_WINDOWS;_USRDLL;VISIONALGO_EXPORTS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(OpenCVRoot)\include;$(ProjectDir)include;$(ProjectDir)Common;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <RuntimeLibrary>MultiThreadedDebugDLL</RuntimeLibrary>
      <LanguageStandard_C>Default</LanguageStandard_C>
      <!-- 源文件含中文注释，按 UTF-8 解析，避免 GBK 代码页下出现 C4819 / C2447 -->
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <AdditionalLibraryDirectories>$(OpenCVRoot)\lib\x64;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>opencv_world455d.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <PostBuildEvent>
      <Command>if exist "$(OpenCVRoot)\bin\x64\opencv_world455d.dll" xcopy /Y /D "$(OpenCVRoot)\bin\x64\opencv_world455d.dll" "$(OutDir)" || exit /b 0</Command>
      <Message>Copy OpenCV debug runtime</Message>
    </PostBuildEvent>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <Optimization>MaxSpeed</Optimization>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <PreprocessorDefinitions>WIN32;_WIN64;NDEBUG;_WINDOWS;_USRDLL;VISIONALGO_EXPORTS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(OpenCVRoot)\include;$(ProjectDir)include;$(ProjectDir)Common;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
      <!-- 源文件含中文注释，按 UTF-8 解析，避免 GBK 代码页下出现 C4819 / C2447 -->
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
      <AdditionalLibraryDirectories>$(OpenCVRoot)\lib\x64;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>opencv_world455.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <PostBuildEvent>
      <Command>if exist "$(OpenCVRoot)\bin\x64\opencv_world455.dll" xcopy /Y /D "$(OpenCVRoot)\bin\x64\opencv_world455.dll" "$(OutDir)" || exit /b 0</Command>
      <Message>Copy OpenCV release runtime</Message>
    </PostBuildEvent>
  </ItemDefinitionGroup>

  <!-- 头文件夹：include 下放对外头文件，其中 algo 子目录按算法类别分文件 -->
  <ItemGroup>
    <ClInclude Include="include\vision_algo.h" />
    <ClInclude Include="include\algo\va_preprocess.h" />
    <ClInclude Include="include\algo\va_blob.h" />
    <ClInclude Include="include\algo\va_fit.h" />
    <ClInclude Include="include\algo\va_match.h" />
    <ClInclude Include="include\algo\va_measure.h" />
  </ItemGroup>
  <!-- 源文件夹：src 下放实现，其中 algo 子目录对应各算法头文件 -->
  <ItemGroup>
    <ClCompile Include="src\vision_algo.cpp" />
    <ClCompile Include="src\algo\algo_preprocess.cpp" />
    <ClCompile Include="src\algo\algo_blob.cpp" />
    <ClCompile Include="src\algo\algo_fit.cpp" />
    <ClCompile Include="src\algo\algo_match.cpp" />
    <ClCompile Include="src\algo\algo_measure.cpp" />
  </ItemGroup>
  <!-- Common 文件夹：导出宏、错误码、公共类型、生命周期与内部工具，
       头文件与源文件同目录，被 include 与 src 共同引用 -->
  <ItemGroup>
    <ClInclude Include="Common\va_export.h" />
    <ClInclude Include="Common\va_error.h" />
    <ClInclude Include="Common\va_types.h" />
    <ClInclude Include="Common\va_lifecycle.h" />
    <ClInclude Include="Common\va_internal.h" />
    <ClCompile Include="Common\va_internal.cpp" />
  </ItemGroup>
  <!-- 依赖说明（在解决方案资源管理器中归入 ThirdParty 文件夹，见 .filters） -->
  <ItemGroup>
    <Text Include="..\..\ThirdParty\README.md" />
    <Text Include="..\..\ThirdParty\HikVision\README.md" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
