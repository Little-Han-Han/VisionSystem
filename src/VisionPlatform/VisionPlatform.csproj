  <PropertyGroup>
    <!-- 把 C++ 算法库及其 OpenCV 运行时复制到主程序输出目录 -->
    <PostBuildEvent>xcopy /Y /D /Q "$(ProjectDir)..\..\bin\x64\$(ConfigurationName)\VisionAlgo.Native.dll" "$(TargetDir)" &gt;nul 2&gt;&amp;1
if not exist "$(TargetDir)thirdparty\opencv" mkdir "$(TargetDir)thirdparty\opencv"
if /i "$(ConfigurationName)"=="Debug" (xcopy /Y /D /Q "$(ProjectDir)..\..\ThirdParty\OpenCV\bin\x64\opencv_world455d.dll" "$(TargetDir)thirdparty\opencv\" &gt;nul 2&gt;&amp;1) else (xcopy /Y /D /Q "$(ProjectDir)..\..\ThirdParty\OpenCV\bin\x64\opencv_world455.dll" "$(TargetDir)thirdparty\opencv\" &gt;nul 2&gt;&amp;1)
if not exist "$(TargetDir)thirdparty\sqlite" mkdir "$(TargetDir)thirdparty\sqlite"
xcopy /Y /D /Q "$(ProjectDir)..\..\ThirdParty\SQLite\sqlite3.dll" "$(TargetDir)thirdparty\sqlite\" &gt;nul 2&gt;&amp;1
if exist "$(ProjectDir)..\..\ThirdParty\Communication" if not exist "$(TargetDir)Communication" mkdir "$(TargetDir)Communication"
if exist "$(ProjectDir)..\..\ThirdParty\Communication\*.dll" xcopy /Y /D /Q "$(ProjectDir)..\..\ThirdParty\Communication\*.dll" "$(TargetDir)Communication\" &gt;nul 2&gt;&amp;1
exit /b 0</PostBuildEvent>
  </PropertyGroup>
  <!-- assets\ 是【源资源】（仓库根，入 git）：只有 app.ico 通过上面的 <ApplicationIcon>
       嵌进 exe，运行时窗体图标从 exe 提取（UiStyle.AppIcon）。
       png / svg 是设计源文件，程序运行不读它们 —— 所以【不再】复制到输出目录，
       避免 bin\x64\<配置>\assets 与仓库根 assets 出现两份重复。 -->
</Project>